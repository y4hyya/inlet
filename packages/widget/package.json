{
  "name": "@inletkit/widget",
  "version": "0.1.1",
  "description": "Deposit from any chain into any position. The React widget for Inlet.",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./styles.css": "./dist/styles.css"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json && cp src/styles.css dist/styles.css",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@inletkit/sdk": "workspace:*"
  },
  "peerDependencies": {
    "@privy-io/react-auth": "^3",
    "@privy-io/wagmi": "^4",
    "@tanstack/react-query": "^5",
    "react": ">=18",
    "react-dom": ">=18",
    "viem": "^2",
    "wagmi": ">=2"
  },
  "devDependencies": {
    "@privy-io/react-auth": "^3.40.0",
    "@privy-io/wagmi": "^4.0.17",
    "@tanstack/react-query": "^5.102.8",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "viem": "^2.56.3",
    "wagmi": "^3.7.7"
  }
}
