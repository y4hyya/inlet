{
  "name": "@inletkit/sdk",
  "version": "0.2.0-stellar.1",
  "description": "Types, hashing, and Circle helpers for Inlet deposits.",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./stellar": {
      "types": "./dist/stellarExit.d.ts",
      "import": "./dist/stellarExit.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "generate": "node scripts/generate.mjs",
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@solana-program/token": "^0.16.1",
    "@solana/kit": "^8.3.0",
    "viem": "^2.56.3"
  },
  "peerDependencies": {
    "@stellar/stellar-sdk": ">=13"
  },
  "peerDependenciesMeta": {
    "@stellar/stellar-sdk": {
      "optional": true
    }
  },
  "devDependencies": {
    "@stellar/stellar-sdk": "^17.1.0"
  }
}
